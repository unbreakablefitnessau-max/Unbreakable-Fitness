        },
        "senderName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "senderRole": {
          "type": "string",
          "enum": [
            "Member",
            "Admin"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "attachmentType": {
          "type": "string",
          "enum": [
            "none",
            "workout"
          ]
        },
        "attachmentSummary": {
          "type": "string",
          "maxLength": 160
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
