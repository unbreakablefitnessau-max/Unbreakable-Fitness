  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPublicProfile"
      },
      "description": "Public athlete profile records (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Private PII subcollection isolated to owner and admins."
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Admin role directory."
    },
    "/workouts/{workoutId}": {
      "schema": {
        "$ref": "#/entities/WorkoutProgram"
      },
      "description": "Training sessions and WODs."
    },
    "/workoutLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/WorkoutLog"
      },
      "description": "User workout completion logs."
    },
    "/personalRecords/{prId}": {
      "schema": {
        "$ref": "#/entities/PersonalRecord"
      },
      "description": "User benchmark personal records."
    },
    "/dailyCheckins/{checkinId}": {
      "schema": {
        "$ref": "#/entities/DailyCheckin"
      },
      "description": "Daily hydration, sleep, and readiness check-ins."
    },
    "/classes/{classId}": {
      "schema": {
        "$ref": "#/entities/StudioClass"
      },
      "description": "Scheduled studio and online group classes."
    },
    "/classes/{classId}/bookings/{userId}": {
      "schema": {
        "$ref": "#/entities/ClassBooking"
      },
      "description": "Member bookings for a scheduled studio class."
    },
    "/challenges/{challengeId}": {
      "schema": {
        "$ref": "#/entities/ClubChallenge"
      },
      "description": "Club-wide fitness challenges."
    },
    "/channels/{channelId}": {
      "schema": {
        "$ref": "#/entities/ChatChannel"
      },
      "description": "Community group chat channels."
    },
    "/channels/{channelId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Messages belonging to a group chat channel."
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "Pinned announcements created by coaches and admins."
    }
  }
}
