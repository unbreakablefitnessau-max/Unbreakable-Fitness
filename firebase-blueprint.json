            "Conditioning",
            "Hypertrophy",
            "Mobility"
          ]
        },
        "durationMin": {
          "type": "integer"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "completedSets": {
          "type": "integer"
        },
        "notes": {
          "type": "string",
          "maxLength": 300
