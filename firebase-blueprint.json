        "difficulty": {
          "type": "string",
          "enum": [
            "Foundation",
            "Intermediate",
            "Rx Athlete"
          ]
        },
        "durationMin": {
          "type": "integer"
        },
        "coachName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "imageKey": {
          "type": "string",
          "enum": [
            "strength",
            "conditioning",
            "mobility"
          ]
        },
        "featured": {
          "type": "boolean"
        },
        "exercises": {
          "type": "array"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "difficulty",
        "durationMin",
        "coachName",
        "description",
        "imageKey",
        "featured",
        "exercises",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
