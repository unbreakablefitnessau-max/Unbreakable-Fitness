{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public athlete profile for Unbeatable Fitness AU community directory and chat attribution (no PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "hub": {
          "type": "string",
          "enum": [
            "Sydney CBD",
            "Melbourne Southbank",
            "Brisbane Valley",
            "Gold Coast",
            "Online AU"
          ]
        },
        "goal": {
          "type": "string",
          "enum": [
            "Strength",
            "Hypertrophy",
            "Conditioning",
            "Fat Loss",
            "Mobility"
          ]
        },
        "experience": {
          "type": "string",
          "enum": [
            "Foundation",
            "Intermediate",
            "Rx Athlete"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "suspended"
          ]
        },
        "sessionsCompleted": {
          "type": "integer"
        },
        "totalVolumeKg": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "hub",
        "goal",
        "experience",
        "status",
        "sessionsCompleted",
        "totalVolumeKg",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing the athlete's private email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin/coach privilege record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "assignedBy",
        "createdAt"
      ]
    },
    "WorkoutProgram": {
      "title": "WorkoutProgram",
