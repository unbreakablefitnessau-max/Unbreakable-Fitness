rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'macksvilles@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---------------------------------------------------------
    // Entity Validation Blueprints
    // ---------------------------------------------------------
    function isValidUserPublic(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'hub', 'goal', 'experience',
          'status', 'sessionsCompleted', 'totalVolumeKg', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'hub', 'goal', 'experience',
          'status', 'sessionsCompleted', 'totalVolumeKg', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.hub in ['Sydney CBD', 'Melbourne Southbank', 'Brisbane Valley', 'Gold Coast', 'Online AU']
        && data.goal in ['Strength', 'Hypertrophy', 'Conditioning', 'Fat Loss', 'Mobility']
        && data.experience in ['Foundation', 'Intermediate', 'Rx Athlete']
        && data.status in ['active', 'suspended']
        && data.sessionsCompleted is int && data.sessionsCompleted >= 0 && data.sessionsCompleted <= 100000
        && (data.totalVolumeKg is int || data.totalVolumeKg is float) && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'assignedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'assignedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.assignedBy is string && data.assignedBy.size() >= 1 && data.assignedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidWorkout(data) {
      return data.keys().hasAll([
          'id', 'title', 'category', 'difficulty', 'durationMin',
          'coachName', 'description', 'imageKey', 'featured', 'exercises',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'category', 'difficulty', 'durationMin',
          'coachName', 'description', 'imageKey', 'featured', 'exercises',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.category in ['Strength', 'Conditioning', 'Hypertrophy', 'Mobility']
        && data.difficulty in ['Foundation', 'Intermediate', 'Rx Athlete']
        && data.durationMin is int && data.durationMin >= 5 && data.durationMin <= 240
        && data.coachName is string && data.coachName.size() >= 2 && data.coachName.size() <= 60
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 500
        && data.imageKey in ['strength', 'conditioning', 'mobility']
        && data.featured is bool
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 15
        && data.exercises[0] is map
        && data.exercises[0].keys().hasAll(['name', 'sets', 'reps', 'restSec'])
        && data.exercises[0].keys().hasOnly(['name', 'sets', 'reps', 'restSec'])
        && data.exercises[0].name is string && data.exercises[0].name.size() >= 2 && data.exercises[0].name.size() <= 60
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkoutLog(data) {
      return data.keys().hasAll([
          'id', 'userId', 'workoutId', 'workoutTitle', 'category',
          'durationMin', 'totalVolumeKg', 'completedSets', 'notes', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'workoutId', 'workoutTitle', 'category',
          'durationMin', 'totalVolumeKg', 'completedSets', 'notes', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && isValidId(data.workoutId)
        && data.workoutTitle is string && data.workoutTitle.size() >= 3 && data.workoutTitle.size() <= 80
        && data.category in ['Strength', 'Conditioning', 'Hypertrophy', 'Mobility']
        && data.durationMin is int && data.durationMin >= 1 && data.durationMin <= 300
        && (data.totalVolumeKg is int || data.totalVolumeKg is float) && data.totalVolumeKg >= 0 && data.totalVolumeKg <= 500000
        && data.completedSets is int && data.completedSets >= 1 && data.completedSets <= 200
        && data.notes is string && data.notes.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidPersonalRecord(data) {
      return data.keys().hasAll([
          'id', 'userId', 'movement', 'value', 'unit', 'reps', 'estimatedOneRmKg', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'movement', 'value', 'unit', 'reps', 'estimatedOneRmKg', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.movement is string && data.movement.size() >= 2 && data.movement.size() <= 60
        && (data.value is int || data.value is float) && data.value >= 0 && data.value <= 2000
        && data.unit in ['kg', 'reps', 'min', 'sec']
        && data.reps is int && data.reps >= 1 && data.reps <= 500
        && (data.estimatedOneRmKg is int || data.estimatedOneRmKg is float) && data.estimatedOneRmKg >= 0 && data.estimatedOneRmKg <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyCheckin(data) {
      return data.keys().hasAll([
          'id', 'userId', 'dateKey', 'waterLitres', 'sleepHours', 'readiness', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'dateKey', 'waterLitres', 'sleepHours', 'readiness', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.userId)
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.waterLitres is int || data.waterLitres is float) && data.waterLitres >= 0 && data.waterLitres <= 12
        && (data.sleepHours is int || data.sleepHours is float) && data.sleepHours >= 0 && data.sleepHours <= 24
        && data.readiness is int && data.readiness >= 1 && data.readiness <= 5
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioClass(data) {
      return data.keys().hasAll([
          'id', 'title', 'hub', 'category', 'coachName', 'dayLabel', 'timeLabel', 'capacity',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'hub', 'category', 'coachName', 'dayLabel', 'timeLabel', 'capacity',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.hub in ['Sydney CBD', 'Melbourne Southbank', 'Brisbane Valley', 'Gold Coast', 'Online AU']
        && data.category in ['Strength', 'Conditioning', 'Hypertrophy', 'Mobility']
        && data.coachName is string && data.coachName.size() >= 2 && data.coachName.size() <= 60
        && data.dayLabel is string && data.dayLabel.size() >= 3 && data.dayLabel.size() <= 30
        && data.timeLabel is string && data.timeLabel.size() >= 4 && data.timeLabel.size() <= 30
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 500
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassBooking(data) {
      return data.keys().hasAll(['userId', 'classId', 'athleteName', 'createdAt'])
        && data.keys().hasOnly(['userId', 'classId', 'athleteName', 'createdAt'])
        && isValidId(data.userId)
        && isValidId(data.classId)
        && data.athleteName is string && data.athleteName.size() >= 2 && data.athleteName.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidClubChallenge(data) {
      return data.keys().hasAll(['id', 'title', 'metric', 'targetValue', 'rewardText', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'metric', 'targetValue', 'rewardText', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 80
        && data.metric in ['sessions', 'volumeKg']
        && (data.targetValue is int || data.targetValue is float) && data.targetValue >= 1 && data.targetValue <= 1000000
        && data.rewardText is string && data.rewardText.size() >= 3 && data.rewardText.size() <= 120
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChannel(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 50
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'id', 'channelId', 'senderId', 'senderName', 'senderRole',
          'body', 'attachmentType', 'attachmentSummary', 'pinned', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'channelId', 'senderId', 'senderName', 'senderRole',
          'body', 'attachmentType', 'attachmentSummary', 'pinned', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.channelId) && data.channelId.size() <= 64
        && isValidId(data.senderId)
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60
        && data.senderRole in ['Member', 'Admin']
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 800
        && data.attachmentType in ['none', 'workout']
        && data.attachmentSummary is string && data.attachmentSummary.size() <= 160
        && data.pinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'body', 'authorId', 'authorName', 'priority', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'body', 'authorId', 'authorName', 'priority', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 90
        && data.body is string && data.body.size() >= 5 && data.body.size() <= 500
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 60
        && data.priority in ['Normal', 'Urgent']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------------------------------------------------------
    // Users (Public Profile vs Private PII Split)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId);
      allow list: if isVerifiedUser() && (resource.data.status == 'active' || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == userId
        && incoming().status == 'active'
        && incoming().sessionsCompleted == 0
        && incoming().totalVolumeKg == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'experience', 'updatedAt'])) ||
          (isOwner(userId) && existing().status == 'active' && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'hub', 'goal', 'experience', 'updatedAt'])) ||
          (isOwner(userId) && existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['sessionsCompleted', 'totalVolumeKg', 'updatedAt'])
            && incoming().sessionsCompleted >= existing().sessionsCompleted
            && incoming().sessionsCompleted <= existing().sessionsCompleted + 1
            && incoming().totalVolumeKg >= existing().totalVolumeKg)
        );

      allow delete: if isAdmin() && isValidId(userId);

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isAdmin());

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivate(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);

        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    // ---------------------------------------------------------
    // Admins Directory
    // ---------------------------------------------------------
    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().assignedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;
    }

    // ---------------------------------------------------------
    // Workouts Catalog
    // ---------------------------------------------------------
    match /workouts/{workoutId} {
      allow get: if isVerifiedUser() && isValidId(workoutId);
      allow list: if isVerifiedUser() && resource.data.durationMin >= 5;

      allow create: if isAdmin()
        && isValidId(workoutId)
        && isValidWorkout(incoming())
        && incoming().id == workoutId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(workoutId)
        && isValidWorkout(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'difficulty', 'durationMin',
          'coachName', 'description', 'imageKey', 'featured', 'exercises', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(workoutId);
    }

    // ---------------------------------------------------------
    // Workout Logs
    // ---------------------------------------------------------
    match /workoutLogs/{logId} {
      allow get: if isVerifiedUser() && isValidId(logId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidWorkoutLog(incoming())
        && incoming().id == logId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/workouts/$(incoming().workoutId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';

      allow update: if isVerifiedUser()
        && isValidId(logId)
        && isValidWorkoutLog(incoming())
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().workoutId == existing().workoutId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['notes']);

      allow delete: if isVerifiedUser() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Personal Records (Strictly Owned)
    // ---------------------------------------------------------
    match /personalRecords/{prId} {
      allow get: if isVerifiedUser() && isValidId(prId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(prId)
        && isValidPersonalRecord(incoming())
        && incoming().id == prId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';

      allow update: if isVerifiedUser()
        && isValidId(prId)
        && isValidPersonalRecord(incoming())
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['value', 'reps', 'estimatedOneRmKg', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(prId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Daily Hydration & Readiness Check-Ins (Strictly Owned)
    // ---------------------------------------------------------
    match /dailyCheckins/{checkinId} {
      allow get: if isVerifiedUser() && isValidId(checkinId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser()
        && isValidId(checkinId)
        && isValidDailyCheckin(incoming())
        && incoming().id == checkinId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(checkinId)
        && isValidDailyCheckin(incoming())
        && (existing().userId == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().dateKey == existing().dateKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['waterLitres', 'sleepHours', 'readiness', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(checkinId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Studio Classes & Member Bookings
    // ---------------------------------------------------------
    match /classes/{classId} {
      allow get: if isVerifiedUser() && isValidId(classId);
      allow list: if isVerifiedUser() && resource.data.capacity >= 1;

      allow create: if isAdmin()
        && isValidId(classId)
        && isValidStudioClass(incoming())
        && incoming().id == classId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(classId)
        && isValidStudioClass(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'hub', 'category', 'coachName', 'dayLabel', 'timeLabel', 'capacity', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(classId);

      match /bookings/{userId} {
        allow get: if isVerifiedUser() && isValidId(classId) && isValidId(userId)
          && exists(/databases/$(database)/documents/classes/$(classId));

        allow list: if isVerifiedUser() && resource.data.classId == classId;

        allow create: if isVerifiedUser()
          && isValidId(classId)
          && isValidId(userId)
          && isOwner(userId)
          && isValidClassBooking(incoming())
          && incoming().userId == userId
          && incoming().classId == classId
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/classes/$(classId))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';

        allow update: if false;

        allow delete: if isVerifiedUser() && isValidId(classId) && isValidId(userId)
          && (isOwner(userId) || isAdmin());
      }
    }

    // ---------------------------------------------------------
    // Club Challenges
    // ---------------------------------------------------------
    match /challenges/{challengeId} {
      allow get: if isVerifiedUser() && isValidId(challengeId);
      allow list: if isVerifiedUser() && resource.data.targetValue >= 1;

      allow create: if isAdmin()
        && isValidId(challengeId)
        && isValidClubChallenge(incoming())
        && incoming().id == challengeId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(challengeId)
        && isValidClubChallenge(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'metric', 'targetValue', 'rewardText', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(challengeId);
    }

    // ---------------------------------------------------------
    // Group Chat Channels & Messages
    // ---------------------------------------------------------
    match /channels/{channelId} {
      allow get: if isVerifiedUser() && isValidId(channelId);
      allow list: if isVerifiedUser() && resource.data.id is string;

      allow create: if isAdmin()
        && isValidId(channelId)
        && isValidChannel(incoming())
        && incoming().id == channelId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(channelId)
        && isValidChannel(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(channelId);

      match /messages/{messageId} {
        allow get: if isVerifiedUser() && isValidId(channelId) && isValidId(messageId)
          && exists(/databases/$(database)/documents/channels/$(channelId));

        allow list: if isVerifiedUser() && resource.data.channelId == channelId;

        allow create: if isVerifiedUser()
          && isValidId(channelId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().id == messageId
          && incoming().channelId == channelId
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/channels/$(channelId))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          && (isAdmin() || (incoming().senderRole == 'Member' && incoming().pinned == false));

        allow update: if isVerifiedUser()
          && isValidId(channelId)
          && isValidId(messageId)
          && isValidChatMessage(incoming())
          && incoming().id == existing().id
          && incoming().channelId == existing().channelId
          && incoming().senderId == existing().senderId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'body', 'updatedAt'])) ||
            (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt']))
          );

        allow delete: if isVerifiedUser()
          && isValidId(messageId)
          && isValidId(channelId)
          && (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // ---------------------------------------------------------
    // Club Announcements
    // ---------------------------------------------------------
    match /announcements/{announcementId} {
      allow get: if isVerifiedUser() && isValidId(announcementId);
      allow list: if isVerifiedUser() && resource.data.priority in ['Normal', 'Urgent'];

      allow create: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().id == announcementId
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'priority', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(announcementId);
    }
  }
}
